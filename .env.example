# ─── Database ────────────────────────────────────────────────────────────────
# Local (host) — used when running `npm run dev` on your machine
DATABASE_URL="postgresql://tiet:tiet_secret@localhost:5432/tiet_examprep"
# Docker Compose (internal network) — app service uses this
# DATABASE_URL="postgresql://tiet:tiet_secret@db:5432/tiet_examprep"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="change-this-to-a-32-char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Auth Mode ────────────────────────────────────────────────────────────────
# Set to "true" for prototype/dev mode:
#   - Any @thapar.edu email is accepted (no real OTP or OAuth)
#   - Demo accounts use password: demo123
# Set to "false" (or remove) for production Google SSO
DEV_AUTH="true"

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Provider to use: "gemini" (default) | extend by adding new providers in lib/llm/
LLM_PROVIDER="gemini"

# Gemini API key — obtain from https://aistudio.google.com/app/apikey
# NEVER commit your actual key. Keep it here only in your local .env file.
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model config
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ─── Object Storage ───────────────────────────────────────────────────────────
# "local" stores files in ./uploads/  |  "s3" for S3-compatible storage
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="25"

# S3 settings (only needed when STORAGE_DRIVER=s3)
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
